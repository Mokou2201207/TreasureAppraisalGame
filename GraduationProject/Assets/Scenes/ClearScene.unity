    m_LineSpacing: 1.4
  m_Text: "\u501F\u91D1\u3092\u8FD4\u3057\u7D42\u3048\u305F\u3042\u306E\u65E5\u304B\u3089\u3001\u753A\u306B\u306F\u3072\u3068\u3064\u306E\u5642\u304C\u5E83\u307E\u3063\u305F\u3002\n\n\u300C\u3042\u306E\u9451\u5B9A\u5C4B\u306F\u3001\u304A\u5B9D\u306E\u58F2\u308A\u4E0A\u3052\u3060\u3051\u3067\n\u3000\u591A\u984D\u306E\u501F\u91D1\u3092\u8FD4\u3057\u304D\u3063\u305F\u3089\u3057\u3044\u300D\n\n\u3051\u308C\u3069\u3001\u5E97\u4E3B\u304C\u7A3C\u3052\u305F\u306E\u306F\n\u5BA2\u306E\u54C1\u3092\u5B89\u304F\u8CB7\u3044\u305F\u305F\u3044\u305F\u304B\u3089\u3067\u306F\u306A\u3044\u3002\n\n\u8AB0\u3082\u6C17\u3065\u304B\u306A\u304B\u3063\u305F\u672C\u5F53\u306E\u5024\u6253\u3061\u3092\u898B\u629C\u304D\u3001\n\u6301\u3061\u8FBC\u3093\u3060\u5BA2\u306B\u306F\u3001\u305D\u308C\u306B\u898B\u5408\u3063\u305F\u5024\u6BB5\u3092\u304D\u3061\u3093\u3068\u6255\u3046\u3002\n\u305D\u3057\u3066\u3001\u305D\u306E\u76EE\u5229\u304D\u3067\u95C7\u306E\u30AA\u30FC\u30AF\u30B7\u30E7\u30F3\u3092\u52DD\u3061\u629C\u3044\u3066\u304D\u305F\u304B\u3089\u3060\u3002\n\n\u300C\u3042\u306E\u5E97\u306E\u9451\u5B9A\u306A\u3089\u4FE1\u7528\u3067\u304D\u308B\u300D\n\n\u305D\u3093\u306A\u58F0\u304C\u5BA2\u304B\u3089\u5BA2\u3078\u3068\u4F1D\u308F\u308A\u3001\n\u3044\u307E\u3067\u306F\u6BCE\u65E5\u306E\u3088\u3046\u306B\u3001\u305F\u304F\u3055\u3093\u306E\u304A\u5B9D\u304C\u6301\u3061\u8FBC\u307E\u308C\u308B\u3002\n\n\u4ECA\u65E5\u3082\u5E97\u306E\u6249\u304C\u958B\u304F\u3002\n\u5E97\u4E3B\u306F\u3053\u308C\u304B\u3089\u3082\u3001\u3072\u3068\u3064\u3072\u3068\u3064\u306E\u304A\u5B9D\u3068\u5411\u304D\u5408\u3044\u3001\n\u305D\u306E\u4FA1\u5024\u3092\u898B\u6975\u3081\u7D9A\u3051\u308B\u3002"
